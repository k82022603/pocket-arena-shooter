{
  "name": "arena-shooter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "play": "node scripts/start-lan.mjs",
    "dev": "npm run dev -w apps/web",
    "dev:https": "npm run dev:https -w apps/web",
    "dev:signaling": "npm run dev -w apps/signaling",
    "build": "npm run build --workspaces --if-present",
    "icons": "node scripts/make-icons.mjs",
    "check:sim": "tsx scripts/sim-check.ts",
    "check:balance": "tsx scripts/coop-balance.ts",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
